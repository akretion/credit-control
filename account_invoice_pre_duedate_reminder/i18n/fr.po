#. module: account_invoice_pre_duedate_reminder
#: model_terms:ir.ui.view,arch_db:account_invoice_pre_duedate_reminder.view_account_config_settings
msgid ""
"Delay(s) in days before the invoice due date, separated by commas. For "
"example '10,5' sends a reminder 10 days before the due date and another one "
"5 days before. Leave empty to disable."
msgstr ""
"Délai(s) en jours avant la date d'échéance de la facture, séparés par des "
"virgules. Par exemple '10,5' envoie un rappel 10 jours avant l'échéance et "
"un autre 5 jours avant. Laisser vide pour désactiver. "

#. module: account_invoice_pre_duedate_reminder
#: model:ir.model.fields,help:account_invoice_pre_duedate_reminder.field_res_company__pre_duedate_reminder_interval_days
#: model:ir.model.fields,help:account_invoice_pre_duedate_reminder.field_res_config_settings__pre_duedate_reminder_interval_days
