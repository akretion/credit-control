#. module: account_invoice_pre_duedate_reminder
#: model:mail.template,body_html:account_invoice_pre_duedate_reminder.pre_duedate_invoice_reminder_mail_template
msgid "\n"
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"<p style=\"margin:0px 0px 9px 0px;\">Cher client,</p>\n"
"\n"
"<p style=\"margin:0px 0px 9px 0px;\">Les factures suivantes sont impayées et arrivent à échance:</p>\n"
"\n"
"% for inv in object.invoice_ids.sorted(key='date_invoice'):\n"
"    <li>\n"
"        Facture : ${inv.number}, date d'échéance : ${format_date(inv.date_due)}, montant total : ${format_amount(inv.amount_total_signed, inv.currency_id)}\n"
"    </li>\n"
"% endfor\n"
"<br>\n"
"\n"
"<p style=\"margin:0px 0px 9px 0px;\">Si vous avez déjà payé ces factures entre temps, veuillez ne pas considerer cet email.</p>\n"
"\n"
"% if object.company_id.overdue_reminder_attach_invoice:\n"
"<p style=\"margin:0px 0px 9px 0px;\">Vous trouverez ci-joint les factures concernées.</p>\n"
"% endif\n"
"\n"
"<p style=\"margin:0px 0px 9px 0px;\">Cordialement,</p>\n"
"\n"
"</div>\n"
""
