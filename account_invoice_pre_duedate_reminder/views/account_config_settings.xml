<odoo>
    <record id="view_account_config_settings" model="ir.ui.view">
        <field name="name">account settings </field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <block id="invoicing_settings" position="after">
                <block id="pre_due_reminder" title="Pre Due Date Invoice Reminder">
                    <setting
                        id="pre_duedate_reminder_interval_days"
                        help="Delay(s) in days before the invoice due date, separated by commas. For example '10,5' sends a reminder 10 days before the due date and another one 5 days before. Leave empty to disable."
                    >
                        <field
                            name="pre_duedate_reminder_interval_days"
                            class="oe_inline"
                            placeholder="10,5"
                        />
                    </setting>
                </block>
            </block>
        </field>
    </record>
</odoo>
